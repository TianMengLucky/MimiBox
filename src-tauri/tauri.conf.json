{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mimibox",
  "version": "0.1.0",
  "identifier": "com.TianMengLuckey.MimiBox",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "美美工具箱",
        "width": 800,
        "height": 600,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBQkJDQjRGNDM0QTdEMjMKUldRamZVcERUOHU3K3RPaVN4QXJldEt5VDZSQm84UFJmRkE1c1l2SUhldlcwSFltNm0wSUlwenYK",
      "endpoints": [
        "https://github.com/TianMengLucky/MimiBox/releases/latest/download/latest.json"
      ]
    }
  }
}
