{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MimiBox-X",
  "version": "0.2.3",
  "identifier": "com.TianMengLuckey.MimiBox",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "美美工具箱",
        "width": 1200,
        "height": 660,
        "decorations": false,
        "dragDropEnabled": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": [
      "../Plugins/*/plugin.json",
      "../Plugins/*/backend.dll",
      "../Plugins/*/frontend/index.js",
      "icons/file-miz.ico",
      "icons/file-mip.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["miz"],
        "name": "MimiBox.X.SchemePackage",
        "description": "美美工具箱方案包",
        "role": "Editor"
      },
      {
        "ext": ["mip"],
        "name": "MimiBox.X.PluginPackage",
        "description": "美美工具箱插件包",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      },
      "wix": {
        "language": {
          "en-US": {
            "localePath": "./windows/msi-en-US.wxl"
          }
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBQkJDQjRGNDM0QTdEMjMKUldRamZVcERUOHU3K3RPaVN4QXJldEt5VDZSQm84UFJmRkE1c1l2SUhldlcwSFltNm0wSUlwenYK",
      "endpoints": [
        "https://github.com/TianMengLucky/MimiBox/releases/download/x-latest/latest.json"
      ]
    }
  }
}
